################################################################################
#
# RevBayes script: Posterior data prediction for cultural evolution under the FBD
#
# This file: Stage 2 - simulates one data set per (thinned) posterior sample.
#
# Expects (set by PPS.sh): mymodel, base_str, sim_dir, pps_thinning
#
# authors: B. Willink, M. Araya
#
# Based on: Bayesian model testing using posterior predictive simulation
# authors: Lyndon M. Coghill, Sebastian Hoehna and Jeremy M. Brown
################################################################################

## read the posterior samples written by the MCMC stage
trace = readStochasticVariableTrace(base_str + "_posterior.var", burnin=0.25, delimiter=TAB)
# If v 1.4.2
trace = readStochasticVariableTrace(base_str + "_posterior.var", delimiter=TAB)

## create and run the posterior predictive simulation
pps = posteriorPredictiveSimulation(mymodel, directory=sim_dir, trace)
pps.run(thinning=pps_thinning)

# Mark the simulation as finished (PPS.sh checks for this file)
write(file=base_str + ".sim_done", "done", append=FALSE)
