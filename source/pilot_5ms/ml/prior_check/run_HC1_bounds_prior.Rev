# Sample the HC1 bounds pilot model (relaxed clock) from the prior, ignoring the data, to compare its prior with BEAST2 SA
# Run from the project root: rb source/pilot_5ms/ml/prior_check/run_HC1_bounds_prior.Rev
alignment = "./data/processed/pilot_5ms/nexus/HC1_5ms_bounds.nex"
fossils = "./data/processed/pilot_5ms/taxa/HC1_5ms_bounds.tsv"
base_str = "./output/pilot_5ms/ml/prior_check/HC1_bounds_revbayes_prior"
clade_extant = clade("HC1-C4-2013", "HC1-K1-2013", "HC1-K2-2013")
burnin_generations = 5000
run_generations = 100000
tuning_interval = 200
source("./source/pilot_5ms/ml/prior_check/control_prior.Rev")
